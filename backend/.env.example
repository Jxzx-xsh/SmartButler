# SmartButler 后端环境变量示例
#
# 用法：复制本文件为 .env（cp .env.example .env），按需覆盖下列变量。
# 未覆盖的项目会使用代码内置的默认值（各 src/**/config.ts 读取 process.env 并带默认回退）。
# 启动脚本通过 Node 原生 --env-file-if-exists=.env 注入，.env 缺失时不报错、继续用默认值。
# 注意：.env 含真实配置/令牌，已被 .gitignore 忽略，切勿提交；本示例文件可提交。

# ============ 通用 ============
# HTTP 监听端口（后端 listen host 固定 0.0.0.0）。缺省 3000。
SMARTBUTLER_PORT=3000
# SQLite 数据库文件路径。缺省 backend/data/smartbutler.db（父目录自动创建）。
SMARTBUTLER_DB_PATH=./data/smartbutler.db

# ============ LM Studio（本地大模型，OpenAI 兼容端点）============
# OpenAI 兼容端点基址，形如 http://host:1234/v1。缺省 http://localhost:1234/v1。
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# API Key。LM Studio 本地不校验，占位即可。缺省 lm-studio。
LMSTUDIO_API_KEY=lm-studio
# 文本对话默认模型。缺省 qwen/qwen3-4b-2507。
LMSTUDIO_TEXT_MODEL=qwen/qwen3-4b-2507
# 视觉（多模态）默认模型。缺省 qwen/qwen3-vl-8b。
LMSTUDIO_VISION_MODEL=qwen/qwen3-vl-8b
# 向量嵌入默认模型（768 维）。缺省 text-embedding-nomic-embed-text-v1.5。
LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# 语音转写（STT）旧配置的 whisper 模型 id（当前转写走本地 whisper.cpp，此项为遗留）。缺省 whisper-large-v3-turbo。
LMSTUDIO_STT_MODEL=whisper-large-v3-turbo
# 请求超时毫秒数（首次加载模型较慢）。缺省 120000。
LMSTUDIO_TIMEOUT_MS=120000

# ============ whisper.cpp（本地语音转写）============
# whisper-cli 命令路径或命令名。缺省 whisper-cli（走 PATH，brew 安装后在 /opt/homebrew/bin/whisper-cli）。
WHISPER_CLI_PATH=whisper-cli
# whisper.cpp ggml 模型文件绝对路径（须为 ggml .bin，非 GGUF）。缺省 backend/models/ggml-small.bin。
WHISPER_MODEL_PATH=/Users/hb02995/other-work/SmartButler/backend/models/ggml-small.bin
# 转写语言。缺省 zh（中文家庭场景）。
WHISPER_LANGUAGE=zh

# ============ 采集网关（ffmpeg 拉流）============
# 采集源地址（ffmpeg -i 输入），形如 http://<IP>:8080/video 或 rtsp://<IP>:554/stream。缺省留空=不自动启动采集。
CAPTURE_SOURCE_URL=
# 视频抽帧帧率。缺省 2。
CAPTURE_FPS=2
# ffmpeg 可执行文件路径或命令名。缺省 ffmpeg（走 PATH，brew 安装后在 /opt/homebrew/bin/ffmpeg）。
CAPTURE_FFMPEG_PATH=ffmpeg
# 断线重连前的等待毫秒数。缺省 2000。
CAPTURE_RECONNECT_DELAY_MS=2000
# 自动重连最大次数（0=不自动重连，到达上限后需手动 start 恢复）。缺省 10。
CAPTURE_MAX_RECONNECTS=10

# ============ 门控-移动侦测（帧差法）============
# 变化像素比例阈值（0..1），changedRatio ≥ 此值视为一次运动命中。缺省 0.08。
MOTION_THRESHOLD=0.08
# 移动侦测灰度缩略图宽度（像素）。缺省 64。
MOTION_THUMB_WIDTH=64
# 移动侦测灰度缩略图高度（像素）。缺省 48。
MOTION_THUMB_HEIGHT=48
# 判定单像素发生变化的灰度差阈值（0..255）。缺省 24。
MOTION_PER_PIXEL_DELTA=24
# 两次运动事件之间的冷却毫秒数。缺省 1500。
MOTION_COOLDOWN_MS=1500
# 产出一次运动事件所需的最小连续命中帧数（最小 1）。缺省 1。
MOTION_MIN_CONSECUTIVE_FRAMES=1

# ============ 门控-语音活动检测（VAD）============
# VAD 能量（RMS）阈值（0..32767），帧 RMS 超过此值视为有声。缺省 500。
VAD_ENERGY_THRESHOLD=500
# VAD 帧长（毫秒），限制在 20..30。缺省 20。
VAD_FRAME_MS=20
# 连续超阈值累计达此时长（ms）进入 speech 态。缺省 150。
VAD_TRIGGER_MS=150
# 连续低于阈值累计达此时长（ms）回到 silence 态。缺省 600。
VAD_HANGOVER_MS=600
# 段时长小于此值（ms）的过短事件丢弃。缺省 300。
VAD_MIN_EVENT_MS=300
# 两段语音事件之间的冷却毫秒数。缺省 500。
VAD_COOLDOWN_MS=500

# ============ Home Assistant 集成 ============
# HA REST API 基址，形如 http://ha:8123（去除末尾斜杠）。留空=未配置，相关端点优雅降级。
HA_BASE_URL=
# 长期访问令牌（敏感）。请替换为自己的令牌，切勿提交真实令牌。
HA_TOKEN=your-long-lived-access-token
# HA WebSocket 地址。留空=从非空 HA_BASE_URL 自动推导（http→ws、https→wss，拼接 /api/websocket）。
HA_WS_URL=
# HA REST 请求超时毫秒数。缺省 10000。
HA_TIMEOUT_MS=10000
# HA WS 重连退避基准毫秒。缺省 1000。
HA_WS_RECONNECT_BASE_MS=1000
# HA WS 重连退避上限毫秒。缺省 30000。
HA_WS_RECONNECT_MAX_MS=30000
# 订阅的 HA 事件类型。缺省 state_changed。
HA_WS_EVENT_TYPE=state_changed

# ============ 主动到期提醒 ============
# 提醒调度器检查间隔（毫秒）。到点检查临期物品：HA 已配置则更新传感器，无论是否配置都落一条提醒事件日志。缺省 3600000（1 小时）。非法或 <=0 回退默认。
REMINDER_INTERVAL_MS=3600000
# 临期窗口天数（N 天内到期含已过期视为临期）。缺省 3。非法或 <=0 回退默认。
REMINDER_EXPIRY_DAYS=3
